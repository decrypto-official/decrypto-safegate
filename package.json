{
  "name": "decrypto-safegate",
  "version": "0.2.0",
  "description": "An open, reproducible risk methodology for crypto tokens. Reads structure from the chain, scores three axes, and always publishes how much it could actually check.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "safegate": "./dist/cli/safegate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "safegate": "tsx src/cli/safegate.ts",
    "test": "vitest run",
    "test:live": "SAFEGATE_LIVE=1 vitest run",
    "test:watch": "vitest",
    "validate": "tsx src/cli/validate.ts",
    "disclosure": "tsx src/cli/disclosure.ts",
    "disclosure:check": "tsx src/cli/disclosure.ts --check",
    "census": "tsx src/cli/census.ts",
    "seed-scores": "tsx src/cli/seed-scores.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "files": [
    "dist",
    "patterns",
    "registry",
    "README.md",
    "METHODOLOGY.md",
    "LIMITATIONS.md",
    "LICENSE",
    "NOTICE"
  ]
}
